<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya365.mini.mapper.BannerMapper" >
  <resultMap id="BaseResultMap" type="com.yunya365.mini.entity.Banner" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="image_url" property="imageUrl" jdbcType="VARCHAR" />
    <result column="ad_link" property="adLink" jdbcType="VARCHAR" />
    <result column="link_type" property="linkType" jdbcType="INTEGER" />
    <result column="link_context" property="linkContext" jdbcType="VARCHAR" />
    <result column="product_id" property="productId" jdbcType="INTEGER" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="upd_time" property="updTime" jdbcType="TIMESTAMP" />
  </resultMap>
  <select id="findBannerList" resultType="com.yunya.feign.ivy_mini.domain.vo.BannerVO">
    SELECT
    bn.id,
    bn.image_url as imageUrl,
    bn.link_type as linkType,
    bn.product_id as productId,
    ac.name as linkContext,
    bn.crt_time as crtTime,
    bn.upd_time as updTime
    FROM banner bn left join  article ac on bn.product_id = ac.id and bn.link_type = 2
    order by bn.crt_time desc
  </select>
</mapper>