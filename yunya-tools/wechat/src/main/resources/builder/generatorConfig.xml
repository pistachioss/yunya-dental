<!--        <table tableName="wx_fans" domainObjectName="WxFans"/>-->
<!--        <table tableName="wx_fans_bind" domainObjectName="WxFansBind"/>-->
<!--        <table tableName="wx_msg_template_configs" domainObjectName="WxMsgTemplateConfigs"/>-->
<!--        <table tableName="wx_msg_templates" domainObjectName="WxMsgTemplates"/>-->
<!--        <table tableName="wx_template_msg_records" domainObjectName="WxTemplateMsgRecords"/>-->
        <table tableName="wx_automsg" domainObjectName="WxAutomsg"/>
    </context>
</generatorConfiguration>