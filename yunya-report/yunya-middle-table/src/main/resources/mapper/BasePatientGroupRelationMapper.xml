<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.middletable.dao.report.BasePatientGroupRelationMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.report.BasePatientGroupRelation" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="patient_id" property="patientId" jdbcType="INTEGER" />
    <result column="group_id" property="groupId" jdbcType="INTEGER" />
    <result column="crt_id" property="crtId" jdbcType="INTEGER" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="upt_id" property="uptId" jdbcType="INTEGER" />
    <result column="upt_time" property="uptTime" jdbcType="TIMESTAMP" />
  </resultMap>

  <select id="selectRegisterdPatientMobile" resultType="com.yunya.models.report.BasePatient">
    select
        DISTINCT mobile
    from base_patient pbi
    inner join base_treatment_process r on r.patient_id=pbi.patient_id
    where r.registered_id>0
      <if test="orgId != null">
        and r.org_id = #{orgId}
      </if>
      <if test="sDate!=null and eDate!=null">
        and date_format(r.registered_date,'%Y') BETWEEN #{sDate} AND #{eDate}
      </if>
      and LENGTH(pbi.mobile)=11
      <if test="mobiles!=null and mobiles.size()>0">
        and pbi.mobile not in
        <foreach collection="mobiles" index="index" item="id" open="(" separator="," close=")">
          #{id}
        </foreach>
      </if>
  </select>
</mapper>