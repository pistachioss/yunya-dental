<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.middletable.dao.report.BaseBillMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.report.BaseBill">
        <!--
          WARNING - @mbg.generated
        -->
        <result column="bill_id" property="billId" jdbcType="INTEGER"/>
        <result column="org_id" property="orgId" jdbcType="INTEGER"/>
        <result column="patient_id" property="patientId" jdbcType="INTEGER"/>
        <result column="treatment_id" property="treatmentId" jdbcType="INTEGER"/>
        <result column="bill_status" property="billStatus" jdbcType="TINYINT"/>
        <result column="order_num" property="orderNum" jdbcType="VARCHAR"/>
        <result column="order_amount" property="orderAmount" jdbcType="DECIMAL"/>
        <result column="order_date" property="orderDate" jdbcType="TIMESTAMP"/>
        <result column="biller_id" property="billerId" jdbcType="INTEGER"/>
        <result column="privilege_type" property="privilegeType" jdbcType="TINYINT"/>
        <result column="privilege_org_id" property="privilegeOrgId" jdbcType="INTEGER"/>
        <result column="privilege_amount" property="privilegeAmount" jdbcType="DECIMAL"/>
        <result column="privilege_date" property="privilegeDate" jdbcType="TIMESTAMP"/>
        <result column="bill_date" property="billDate" jdbcType="TIMESTAMP"/>
        <result column="bill_num" property="billNum" jdbcType="VARCHAR"/>
        <result column="actual_amount" property="actualAmount" jdbcType="DECIMAL"/>
        <result column="received_amount" property="receivedAmount" jdbcType="DECIMAL"/>
        <result column="debt_amount" property="debtAmount" jdbcType="DECIMAL"/>
        <result column="checker_id" property="checkerId" jdbcType="INTEGER"/>
    </resultMap>
    <!-- 批量插入中间表账单记录 -->
    <insert id="batchInsertSelective">
        INSERT INTO base_bill (
        bill_id,
        org_id,
        patient_id,
        treatment_id,
        bill_status,
        order_num,
        order_amount,
        order_date,
        biller_id,
        privilege_type,
        privilege_amount,
        privilege_date,
        bill_date,
        bill_num,
        actual_amount,
        received_amount,
        debt_amount,
        checker_id
        )
        VALUES
        <foreach collection="baseBills" item="item" separator=",">
            (#{item.billId}, #{item.orgId}, #{item.patientId},
            #{item.treatmentId}, #{item.billStatus}, #{item.orderNum},
            #{item.orderAmount}, #{item.orderDate}, #{item.billerId},
            #{item.privilegeType}, #{item.privilegeAmount}, #{item.privilegeDate},
            #{item.billDate}, #{item.billNum}, #{item.actualAmount},
            #{item.receivedAmount}, #{item.debtAmount}, #{item.checkerId})
        </foreach>
    </insert>
</mapper>