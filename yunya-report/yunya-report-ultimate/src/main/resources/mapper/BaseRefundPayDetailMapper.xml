<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.report.ultimate.mapper.BaseRefundPayDetailMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.report.BaseRefundPayDetail">
        <!--
          WARNING - @mbg.generated
        -->
        <id column="bill_refund_pay_detail_record_id" property="billRefundPayDetailRecordId" jdbcType="INTEGER"/>
        <result column="refund_id" property="refundId" jdbcType="INTEGER"/>
        <result column="account_item_id" property="accountItemId" jdbcType="INTEGER"/>
        <result column="principal_amount" property="principalAmount" jdbcType="DECIMAL"/>
        <result column="bonus_amount" property="bonusAmount" jdbcType="DECIMAL"/>
    </resultMap>

    <!-- 根据退费记录ID查询退费支付方式列表 -->
    <select id="selectBillRefundPaymentList" resultType="com.yunya.feign.report.domain.vo.StatementPaymentVO">
        SELECT
            brpd.account_item_id AS accountItemId,
            bai.account_item_name AS accountItemName,
            brpd.principal_amount AS totalAmount,
            brpd.bonus_amount AS bonusAmount
        FROM
            base_refund_pay_detail brpd
            LEFT JOIN base_account_item bai ON brpd.account_item_id = bai.account_item_id
        WHERE brpd.refund_id = #{refundId}
    </select>
</mapper>