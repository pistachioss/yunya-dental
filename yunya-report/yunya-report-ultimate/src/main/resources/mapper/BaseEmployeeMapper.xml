<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.report.ultimate.mapper.BaseEmployeeMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.report.BaseEmployee">
        <!--
          WARNING - @mbg.generated
        -->
        <result column="user_id" property="userId" jdbcType="INTEGER"/>
        <result column="employee_name" property="employeeName" jdbcType="VARCHAR"/>
        <result column="gender" property="gender" jdbcType="TINYINT"/>
        <result column="mobile" property="mobile" jdbcType="VARCHAR"/>
        <result column="work_status" property="workStatus" jdbcType="TINYINT"/>
        <result column="entry_date" property="entryDate" jdbcType="DATE"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="post_level" property="postLevel" jdbcType="VARCHAR"/>
        <result column="bonus_coefficient" property="bonusCoefficient" jdbcType="DOUBLE"/>
        <result column="work_amount" property="workAmount" jdbcType="DOUBLE"/>
        <result column="work_number" property="workNumber" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="fuchaList" resultType="com.yunya.feign.report.domain.vo.FuchaVO">
        select res.name ,res.mobile ,res.treatType ,
        DATE_FORMAT(res.lastVisitDate,'%Y-%m-%d' ) as lastVisitDate,res.lastVisitOutpatient,res.abbreviation as abbreviation,res.lastVisitDoctors,
         res.employeeName
         from (SELECT
        bp. NAME AS NAME,
        bp.mobile AS mobile,
        IF (
        count(btp.patient_id) > 1,
        1,
        0
        ) AS treatType,
        bp.last_visit_date AS lastVisitDate,
        bp.last_visit_outpatient as lastVisitOutpatient,
        bp.last_visit_doctors as lastVisitDoctors,
        be.employee_name AS employeeName,
        bo.abbreviation as abbreviation
        FROM
        base_patient bp
        LEFT JOIN base_treatment_process btp ON bp.patient_id = btp.patient_id
        LEFT JOIN base_employee be ON bp.last_visit_doctors = be.user_id
        LEFT JOIN base_organization bo on  bp.last_visit_outpatient = bo.org_id
        <where>
         bp.last_visit_doctors is not NULL
        <if test="combination != null and combination != ''">
            and concat(IFNULL(bp.name,''),IFNULL(bp.pinyin_name,''),IFNULL(bp.mobile,'')) like
            concat(concat('%',#{combination}),'%')
        </if>
        </where>
        GROUP BY
        bp.patient_id) res
        <where>
            <if test="treatTypes != null and treatTypes.size > 0">
                AND res.treatType IN
                <foreach collection="treatTypes" item="item" index="index" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="days != null and days > 0">
                AND DATEDIFF(DATE_FORMAT(now(),'%Y-%m-%d' ), DATE_FORMAT(res.lastVisitDate,'%Y-%m-%d')) &lt;=  #{days}
            </if>
            <if test="orgIds != null and orgIds.size > 0">
                AND res.lastVisitOutpatient IN
                <foreach collection="orgIds" item="item" index="index" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>

            <if test="attendingDoctors != null and attendingDoctors.size > 0">
                AND res.lastVisitDoctors IN
                <foreach collection="attendingDoctors" item="item" index="index" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>
    <select id="selectByOrgId" resultType="com.yunya.models.report.BaseEmployee">
      select distinct be.* from base_employee be join base_user_post bup on be.user_id =  bup.user_id
      where bup.org_id = #{orgId}  and bup.post_name = '医生'
    </select>
    <!-- 根据ID列表查询用户信息 -->
    <select id="selectUserInfoByIds" resultType="com.yunya.feign.system.vo.SysUserInfoDetail">
        SELECT
            be.user_id AS userId,
            be.employee_name AS name,
            be.mobile AS username,
            be.mobile AS mobilePhone,
            be.gender AS gender,
            be.work_status AS workStatus,
            be.title AS title,
            be.post_level AS postLevel
        FROM
        base_employee be
        <where>
            <if test="userIds != null and userIds.size > 0">
                AND be.user_id IN
                <foreach collection="userIds" item="item" index="index" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

    <!--查询员工和门诊的笛卡尔积-->
    <select id="selectClinicEmployeeCartesianProduct"
            resultType="com.yunya.feign.report.domain.vo.ClinicEmployeBonusCoefficientVO">
        SELECT
            be.user_id AS employeeId,
            be.employee_name AS employeeName,
            <if test="groupByOrgId">
                bo.org_id AS orgId,
                bo.abbreviation,
            </if>
            IFNULL(be.bonus_coefficient, 0) AS bonusCoefficient
        FROM base_employee be
        <if test="groupByOrgId">
            , base_organization bo
        </if>
        <where>
            <if test="groupByOrgId">
                AND bo.org_type = 2
                <if test="query.orgIds != null and query.orgIds.length > 0">
                    and bo.org_id in
                    <foreach collection="query.orgIds" item="item" index="index" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
            </if>
            <if test="query.employeeIds != null and query.employeeIds.length > 0">
                and be.user_id in
                <foreach collection="query.employeeIds" item="item" index="index" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="query.workStatus!=null and query.workStatus.length > 0">
                and be.work_status in
                <foreach collection="query.workStatus" item="item" index="index" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
        ORDER BY
        <if test="groupByOrgId">
            bo.org_id,
        </if>
        be.user_id
    </select>
</mapper>