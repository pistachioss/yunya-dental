<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.report.ultimate.mapper.BasePatientOriginMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.report.BasePatientOrigin">
        <!--
          WARNING - @mbg.generated
        -->
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="parent_id" property="parentId" jdbcType="INTEGER"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="origin_type" property="originType" jdbcType="INTEGER"/>
        <result column="source_attribute" property="sourceAttribute" jdbcType="INTEGER"/>
        <result column="qr_code_path" property="qrCodePath" jdbcType="VARCHAR"/>
        <result column="allow_operate" property="allowOperate" jdbcType="BIT"/>
        <result column="time_limit" property="timeLimit" jdbcType="TINYINT"/>
        <result column="limit_start_date" property="limitStartDate" jdbcType="DATE"/>
        <result column="limit_end_date" property="limitEndDate" jdbcType="DATE"/>
        <result column="inservice" property="inservice" jdbcType="BIT"/>
        <result column="crt_id" property="crtId" jdbcType="INTEGER"/>
        <result column="crt_name" property="crtName" jdbcType="VARCHAR"/>
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP"/>
        <result column="upt_id" property="uptId" jdbcType="INTEGER"/>
        <result column="upd_name" property="updName" jdbcType="VARCHAR"/>
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 获取活动列表 -->
    <select id="selectActivityList" resultType="com.yunya.feign.patient_central.domain.vo.web.ActivityVo">
    SELECT
        id,
        NAME,
        limit_start_date limitStartDate,
        limit_end_date limitEndDate,
        time_limit  timeLimit
    FROM
        base_patient_origin
    WHERE
        origin_type = 3
        AND parent_id != 0
  </select>

  <select id="selectPatientOriginList" resultType="com.yunya.models.report.BasePatientOrigin">
    SELECT
      bpo.id,
      bpo.parent_id,
      bpo.name,
      bpo.origin_type,
      bpo.source_attribute,
      bpo.qr_code_path,
      bpo.allow_operate,
      bpo.time_limit,
      bpo.limit_start_date,
      bpo.limit_end_date
    FROM base_patient_origin bpo
    <where>
        AND bpo.inservice = true
        <if test="query.parentId != null">
            AND bpo.parent_id = #{query.parentId}
        </if>
        <if test="query.originTypes!=null and query.originTypes.size()>0">
            AND bpo.origin_type in
            <foreach collection="query.originTypes" item="item" index="index" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
    </where>

  </select>

  <select id="selectPatientOriginInIds" resultType="com.yunya.models.report.BasePatientOrigin">
    SELECT
      bpo.id,
      bpo.parent_id,
      bpo.name,
      bpo.origin_type,
      bpo.source_attribute,
      bpo.qr_code_path,
      bpo.allow_operate,
      bpo.time_limit,
      bpo.limit_start_date,
      bpo.limit_end_date
    FROM base_patient_origin bpo
    <where>
        <if test="ids!=null and ids.size()>0">
            AND bpo.id in
            <foreach collection="ids" item="item" index="index" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
    </where>
  </select>

</mapper>