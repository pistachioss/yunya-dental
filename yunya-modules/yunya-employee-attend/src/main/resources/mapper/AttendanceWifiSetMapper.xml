<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunya.modules.employeeattend.mapper.AttendanceWifiSetMapper">
  <resultMap id="BaseResultMap" type="com.yunya.models.employee_attend.AttendanceWifiSet">
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="org_id" jdbcType="INTEGER" property="orgId" />
    <result column="wifi_name" jdbcType="VARCHAR" property="wifiName" />
    <result column="mac_address" jdbcType="VARCHAR" property="macAddress" />
    <result column="crt_id" jdbcType="INTEGER" property="crtId" />
    <result column="crt_time" jdbcType="TIMESTAMP" property="crtTime" />
    <result column="upd_id" jdbcType="INTEGER" property="updId" />
    <result column="upd_time" jdbcType="TIMESTAMP" property="updTime" />
  </resultMap>

  <!--分页查询考勤Wifi设置列表-->
  <select id="findAttendanceWifiSetList" resultType="com.yunya.feign.employee_attend.vo.AttendanceWifiSetVO">
    select
        t.id,
        t.org_id as orgId,
        t.wifi_name as wifiName,
        t.mac_address as macAddress
    from attendance_wifi_set t
    <where>
      <if test="queryForm.orgId !=null">
        and t.org_id = #{queryForm.orgId}
      </if>
      <if test="queryForm.macAddress !=null and queryForm.macAddress!=''">
        and t.mac_address = #{queryForm.macAddress}
      </if>
    </where>
    order by t.crt_time desc
  </select>

  <!--根据id查询考勤Wifi设置详情-->
  <select id="findAttendanceWifiSetById" resultType="com.yunya.feign.employee_attend.vo.AttendanceWifiSetVO">
        select
            t.id,
            t.org_id as orgId,
            t.wifi_name as wifiName,
            t.mac_address as macAddress
        from attendance_wifi_set t
        where t.id = #{id}
  </select>

  <!--根据mac查询考勤Wifi设置详情-->
  <select id="findAttendanceWifiSetByMac" resultType="com.yunya.feign.employee_attend.vo.AttendanceWifiSetVO">
        select
            t.id,
            t.org_id as orgId,
            t.wifi_name as wifiName,
            t.mac_address as macAddress
        from attendance_wifi_set t
        where t.mac_address = #{macAddress}
  </select>
</mapper>