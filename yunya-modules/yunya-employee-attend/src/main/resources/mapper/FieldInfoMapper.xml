<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.employeeattend.mapper.FieldInfoMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.employee_attend.FieldInfo">
        <!--
          WARNING - @mbg.generated
        -->
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="field_address" property="fieldAddress" jdbcType="VARCHAR"/>
        <result column="user_id" property="userId" jdbcType="VARCHAR"/>
        <result column="start_time" property="startTime" jdbcType="TIMESTAMP"/>
        <result column="end_time" property="endTime" jdbcType="TIMESTAMP"/>
        <result column="field_reason" property="fieldReason" jdbcType="VARCHAR"/>
        <result column="approval_people_id" property="approvalPeopleId" jdbcType="INTEGER"/>
        <result column="apprpval_status" property="apprpvalStatus" jdbcType="INTEGER"/>
        <result column="crt_id" property="crtId" jdbcType="INTEGER"/>
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP"/>
        <result column="upd_id" property="updId" jdbcType="INTEGER"/>
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP"/>
    </resultMap>
    <resultMap id="FindVOMap" type="com.yunya.feign.employee_attend.vo.FieldInfoListVO">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="company_id" property="companyId" jdbcType="INTEGER"/>
        <result column="field_address" property="fieldAddress" jdbcType="VARCHAR"/>
        <result column="user_id" property="userId" jdbcType="VARCHAR"/>
        <result column="fieldTime" property="fieldTime" jdbcType="VARCHAR"/>
        <result column="start_time" property="startTime" jdbcType="TIMESTAMP"/>
        <result column="end_time" property="endTime" jdbcType="TIMESTAMP"/>
        <result column="field_reason" property="fieldReason" jdbcType="VARCHAR"/>
        <result column="approval_people_id" property="approvalPeopleId" jdbcType="INTEGER"/>
        <result column="apprpval_status" property="apprpvalStatus" jdbcType="INTEGER"/>
        <result column="crt_id" property="crtId" jdbcType="INTEGER"/>
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP"/>
        <result column="upd_id" property="updId" jdbcType="INTEGER"/>
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP"/>
    </resultMap>
    <select id="findList" resultMap="BaseResultMap">
        select * from field_info where apprpval_status in (0,1,2)
        <if test="userId !=null and userId != ''">
            and user_id = #{userId}
        </if>
    </select>

    <select id="findVOList" resultMap="FindVOMap">
        select id,field_address,user_id,start_time,company_id,
        end_time,field_reason,approval_people_id,apprpval_status,TIMESTAMPDIFF(MINUTE,start_time,end_time) fieldTime,crt_time from
        field_info
        <where>
            <if test="id !=null and id != ''">
                and id = #{id}
            </if>
            <if test="userId !=null and userId != ''">
                and user_id = #{userId}
            </if>
            <if test="approvalPeopleId !=null and approvalPeopleId != ''">
                and approval_people_id = #{approvalPeopleId}
            </if>
            <if test="apprpvalStatus == 0 ">
                and apprpval_status = #{apprpvalStatus}
            </if>
            <if test="apprpvalStatus == 1 or apprpvalStatus == 2 ">
                and apprpval_status in (1,2)
            </if>
        </where>
    </select>

    <select id="findFieldInfosByUserIdAndDate" resultType="com.yunya.feign.employee_attend.vo.FieldInfoVO">
        select
        t.id,
        t.company_id as companyId,
        t.user_id as userId,
        t.field_reason as fieldReason,
        t.field_address as fieldAddress,
        t.start_time as startTime,
        t.end_time as endTime,
        t.approval_people_id as approvalPeopleId,
        t.apprpval_status as apprpvalStatus
        from field_info t
        <where>
            t.apprpval_status = 1
            <if test="userIds!=null and userIds.size()>0">
                and t.user_id in
                <foreach collection="userIds" item="item" index="index" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="date != null">
                and DATE_FORMAT(t.start_time,'%Y-%m-%d') = DATE_FORMAT(#{date},'%Y-%m-%d')
            </if>
        </where>
        order by t.start_time asc
    </select>

    <select id="findFieldInfoList" resultType="com.yunya.feign.employee_attend.vo.FieldInfoVO">
        select
        t.id,
        t.user_id as userId,
        t.field_time as fieldTime,
        t.field_reason as fieldReason,
        t.field_address as fieldAddress,
        t.start_time as startTime,
        t.end_time as endTime,
        t.approval_people_id as approvalPeopleId,
        t.apprpval_status as apprpvalStatus
        from field_info t
        <where>
            <if test="queryForm.apprpvalStatus!=null">
                and t.apprpval_status = #{queryForm.apprpvalStatus}
            </if>
            <if test="queryForm.userId!=null">
                and t.user_id = #{queryForm.userId}
            </if>
            <if test="queryForm.betweenDate!=null and queryForm.andDate!=null">
                and DATE_FORMAT(t.start_time,'%Y-%m-%d') between DATE_FORMAT(#{queryForm.betweenDate},'%Y-%m-%d') and
                DATE_FORMAT(#{queryForm.andDate},'%Y-%m-%d')
            </if>
        </where>
        order by t.start_time asc
    </select>

    <select id="countByDay" resultType="Integer">
        select count(*) from field_info where user_id = #{userId} and  DATE_FORMAT(start_time,'%Y-%m-%d') = #{startTime}  and apprpval_status in (0,1)
    </select>
</mapper>