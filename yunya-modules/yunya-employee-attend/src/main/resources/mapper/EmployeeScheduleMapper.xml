  <select id="selectAllByDate" resultMap="BaseResultCopyMap">
        select es.*,bs.first_start_time,bs.first_end_time,bs.second_start_time,bs.second_end_time,bs.name as scheduleName from employee_schedule es
        left join base_schedule bs on es.schedule_id = bs.id
        where
        es.work_date &gt;= #{startDate} and es.work_date &lt;= #{endDate} and es.employee_id in
    <foreach item="item" index="index" collection="list" open="(" separator="," close=")">
            #{item}
    </foreach>
    order by es.work_date
    </select>

  <delete id="deleteByDate">
        delete from employee_schedule where
        work_date &gt;= #{startDate} and work_date &lt;= #{endDate} and employee_id in
    <foreach item="item" index="index" collection="list" open="(" separator="," close=")">
      #{item}
    </foreach>
    </delete>

  <insert id="batchInsert" parameterType="java.util.List">
    insert into employee_schedule (id, clinic_id, employee_id, schedule_id, work_date, crt_id, crt_name,
    crt_time, upd_id, upd_name, upd_time, inservice) VALUES
    <foreach collection="list" item="item" index="index" separator=",">
      (#{item.id,jdbcType=INTEGER}, #{item.clinicId,jdbcType=VARCHAR}, #{item.employeeId,jdbcType=VARCHAR},
      #{item.scheduleId,jdbcType=VARCHAR}, #{item.workDate,jdbcType=TIMESTAMP},
      #{item.crtId,jdbcType=VARCHAR},#{item.crtName,jdbcType=VARCHAR}, #{item.crtTime,jdbcType=TIMESTAMP},
      #{item.updId,jdbcType=VARCHAR}, #{item.updName,jdbcType=VARCHAR}, #{item.updTime,jdbcType=TIMESTAMP},
      #{item.inservice,jdbcType=BIT})
    </foreach>
  </insert>

  <select id="selectByDateAndComEmpId" resultMap="BaseResultMap">
        select * from employee_schedule where DATE_FORMAT(work_date,'%Y-%m-%d') =
        DATE_FORMAT(#{workDate},'%Y-%m-%d')
        and employee_id = #{employeeId}
    </select>

  <select id="selectVOByDateAndCompEmpId" resultMap="EmployeeScheduleVOMap">
    select employee_id,clinic_id,work_date,schedule_id from employee_schedule where
    work_date &gt;= #{startDate} and work_date &lt; #{endDate} and employee_id = #{employeeId}
    <if test="clinicId != null">
      and clinic_id = #{clinicId}
    </if>
    order by work_date
  </select>
</mapper>