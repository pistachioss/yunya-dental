    <select id="findWechatList" resultMap="WxWechatResultMap">
        select wf.id,wf.nick_name as nickName,wf.open_id as openId,wf.register_mobile as mobile,
        wf.crt_time as crtTime,wf.source_type as sourceType,wf.source_type_name as sourceTypeName,wf.bind as isBind,wf.fans_status as fansStatus,wf.address,
        wfb.patient_id as patientId,pbi.name as name,wfb.dictionary_id as dictionaryId,
        case when wf.sex = 1 then '男'
        when wf.sex = 2 then '女'
        else '未知'
        end as sex
        from wx_fans wf
        LEFT JOIN wx_fans_bind wfb ON wf.open_id = wfb.open_id
        LEFT JOIN patient_base_info pbi on wfb.patient_id = pbi.id
        <where>
            <if test="startTime !=null and endTime != null">
                and DATE_FORMAT(wf.crt_time,'%Y-%m-%d') >= DATE_FORMAT(#{startTime},'%Y-%m-%d')
                and DATE_FORMAT(wf.crt_time,'%Y-%m-%d') &lt;= DATE_FORMAT(DATE_ADD(#{endTime},INTERVAL '1'
                DAY),'%Y-%m-%d')
            </if>
            <if test="isBind !=null">
                and wf.bind = #{isBind}
            </if>
            <if test="address !=null and address !=''">
                and concat(wf.address) like concat(concat('%', rtrim(#{address})), '%')
            </if>
            AND concat(IFNULL(pbi.`name`,''),
            IFNULL(pbi.medical_number,''),
            IFNULL(pbi.pinyin_name,''),
            IFNULL(wf.register_mobile,''),
            IFNULL(wf.nick_name,''))
            like concat(concat('%', rtrim(#{name})), '%')
        </where>
        order by wf.crt_time desc
    </select>
    <select id="findList" resultType="com.yunya.feign.patient_central.domain.vo.web.WxFansVo">
        select wf.last_login_address as lastLoginAddress,wf.id,wf.nick_name as nickName,wf.head_imgurl as headImgurl,wf.open_id as
        openId,wf.union_id as
        unionId,pbi.name,wf.register_mobile as mobile,
        wf.remark,wf.crt_time as crtTime,wf.bind as isBind
        ,wf.source_type as sourceType,wf.source_type_name as sourceTypeName,
        case when wf.sex = 1 then '男'
        when wf.sex = 2 then '女'
        else '未知'
        end as sex,
        case when wf.subscribe = 1 then '是'
        else '否'
        end as subscribe
        from wx_fans wf
        LEFT JOIN wx_fans_bind wfb ON wf.open_id = wfb.open_id
        LEFT JOIN patient_base_info pbi on wfb.patient_id = pbi.id
        <where>
            <if test="startTime !=null and endTime != null">
                and DATE_FORMAT(wf.crt_time,'%Y-%m-%d') >= DATE_FORMAT(#{startTime},'%Y-%m-%d')
                and DATE_FORMAT(wf.crt_time,'%Y-%m-%d') &lt;= DATE_FORMAT(DATE_ADD(#{endTime},INTERVAL '1'
                DAY),'%Y-%m-%d')
            </if>
            <if test="isBind !=null">
                and wf.bind = #{isBind}
            </if>
            AND concat(IFNULL(pbi.`name`,''),
            IFNULL(pbi.medical_number,''),
            IFNULL(pbi.pinyin_name,''),
            IFNULL(wf.register_mobile,''),
            IFNULL(wf.nick_name,''))
            like concat(concat('%', rtrim(#{name})), '%')
        </where>
        GROUP BY wf.id
        order by wf.crt_time desc
    </select>


    <select id="findListByName" resultType="com.yunya.feign.patient_central.domain.vo.web.WxFansVo">
        select wf.id,wf.register_name as name,wf.head_imgurl as headImgurl,wf.open_id as openId,wf.register_mobile as
        mobile,wf.nick_name as nickName,
        wf.remark,wf.crt_time as crtTime,wf.bind as isBind,
        case when wf.sex = 1 then '男'
        when wf.sex = 2 then '女'
        else '未知'
        end as sex,
        case when wf.subscribe = 1 then '是'
        else '否'
        end as subscribe
        from wx_fans wf
        <where>
            <if test="name !=null and name !=''">
                AND concat(IFNULL(wf.nick_name,''))
                like concat(concat('%', rtrim(#{name})), '%')
            </if>
        </where>
        GROUP BY wf.id
        order by wf.crt_time desc
    </select>
    <select id="findMapList" resultMap="WxWechatAppMapLsit">
        SELECT
        ROUND(
        6378.138 * 2 * ASIN(
        SQRT(
        POW(
        SIN(
        (
        #{latitude}*PI()/180-wf.latitude*PI()/180)/2),2)+
        COS(
        #{latitude}*PI()/180)*COS(wf.latitude*PI()/180)*POW(SIN((#{longitude}*PI()/180-
        wf.longitude * PI() / 180
        ) / 2
        ),
        2
        )
        )
        ) * 1000
        ) AS distance,
        wf.id as id,
        wf.longitude,
        wf.latitude,
        wf.bind as isBind,
        wf.nick_name as nickName,
        wf.last_login_date as lastLoginDate,
        wf.head_imgurl as headImgurl,
--         COUNT(
--         wfb.id
--         ) AS numBind,
        wfb.patient_id as patientId,pbi.name as name,wfb.dictionary_id as dictionaryId,pbi.mobile as mobile
        FROM
        wx_fans AS wf
        left join wx_fans_bind wfb on wf.union_id = wfb.union_id
        left join patient_base_info pbi on wfb.patient_id = pbi.id
        <where>
            ROUND(
            6378.138 * 2 * ASIN(
            SQRT(
            POW(
            SIN(
            (
            #{latitude}*PI()/180-wf.latitude*PI()/180)/2),2)+
            COS(
            #{latitude}*PI()/180)*COS(wf.latitude*PI()/180)*POW(SIN((#{longitude}*PI()/180-
            wf.longitude * PI() / 180
            ) / 2
            ),
            2
            )
            )
            ) * 1000
            ) &lt;= #{distance}
            <if test="isBind !=null">
                and wf.bind = #{isBind}
            </if>
        </where>


    </select>
    <select id="findNumBind" resultType="com.yunya.feign.patient_central.domain.vo.web.WxWechatMapBindNumFansVo">
        SELECT
        COUNT(
        CASE
        WHEN bind = 1
        THEN
        1
        ELSE
        NULL
        END
        ) AS numBind,
        COUNT(
        CASE
        WHEN bind = 0 or ISNULL(bind)
        THEN
        1
        ELSE
        NULL
        END
        ) AS numNoBind
        FROM
        wx_fans AS wf
        where
        ROUND(
        6378.138 * 2 * ASIN(
        SQRT(
        POW(
        SIN(
        (
        #{latitude}*PI()/180-wf.latitude*PI()/180)/2),2)+
        COS(
        #{latitude}*PI()/180)*COS(wf.latitude*PI()/180)*POW(SIN((#{longitude}*PI()/180-
        wf.longitude * PI() / 180
        ) / 2
        ),
        2
        )
        )
        ) * 1000
        ) &lt;= #{distance}
    </select>

