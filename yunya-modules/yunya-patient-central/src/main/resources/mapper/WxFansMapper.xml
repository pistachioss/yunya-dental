        <foreach collection="list" item="item" separator=",">
            (#{item.registerMobile}, #{item.openId}, #{item.nickName}, #{item.sex}, #{item.birthday},#{item.country},#{item.province},
            #{item.city}, #{item.language}, #{item.headImgurl}, #{item.unionId}, #{item.remark}, #{item.sourceType}, #{item.sourceTypeName}
            , #{item.fansStatus}, #{item.address})
        </foreach>
    </insert>

