    <!-- 根据患者id和预付款卡号 查询退款信息 -->
    <select id="refundList" resultType="com.yunya.feign.patient_central.domain.vo.web.PrepaidMeturnRecordVo">
      SELECT
        id,
        date_format(crt_time,'%Y-%m-%d %H:%i') operatingTime,
        return_principal_amount returnRrincipalAmount,
        return_gift_amount returnGiftAmount,
        org_id orgId,
        crt_id operatorId,
        crt_name operatorName,
        return_way_id returnWayId,
        return_way_type returnWayType,
        remarks
      FROM
          prepaid_return_record
      WHERE
          prepaid_id = #{form.prepaidId}
      ORDER BY crt_time DESC
  </select>

