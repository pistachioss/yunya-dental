        <result column="return_principal_amount" property="returnPrincipalAmount" jdbcType="DECIMAL"/>
        <result column="return_gift_amount" property="returnGiftAmount" jdbcType="DECIMAL"/>
        <result column="remarks" property="remarks" jdbcType="VARCHAR"/>
        <result column="return_way_id" property="returnWayId" jdbcType="INTEGER"/>
