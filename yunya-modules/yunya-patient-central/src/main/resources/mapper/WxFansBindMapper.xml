  </resultMap>
  <insert id="batchInsert" parameterType="java.util.List">
    insert into wx_fans_bind ( patient_id, dictionary_id,open_id,bind,bind_time,is_vip,is_owner, crt_id) VALUES
    <foreach collection="list" item="item" index="index" separator=",">
    (#{item.patientId}, #{item.dictionaryId}, #{item.openId},
    #{item.bind}, #{item.bindTime},#{item.isVip},
    #{item.isOwner}, #{item.crtId}
    )
    </foreach>
  </insert>

    <select id="listWxUsers" resultType="com.yunya.models.patient_central.WxFans">
      select
          wf.open_id,
          wf.nick_name
      from wx_fans_bind wfb
               inner join wx_fans wf on wf.open_id = wfb.open_id
      where wfb.patient_id in
        <foreach collection="list" item="item" open="(" separator="," close=")">
          #{item}
        </foreach>
        and wfb.`bind` = 1
    </select>
</mapper>