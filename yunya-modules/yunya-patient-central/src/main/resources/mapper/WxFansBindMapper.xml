    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="patient_id" property="patientId" jdbcType="INTEGER" />
    <result column="dictionary_id" property="dictionaryId" jdbcType="INTEGER" />
    <result column="open_id" property="openId" jdbcType="VARCHAR" />
    <result column="bind" property="bind" jdbcType="BIT" />
    <result column="bind_time" property="bindTime" jdbcType="TIMESTAMP" />
    <result column="is_vip" property="isVip" jdbcType="BIT" />
