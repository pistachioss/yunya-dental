<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.patient_central.mapper.WxFansBindMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.patient_central.WxFansBind" >
