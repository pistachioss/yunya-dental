<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.clinic.discount.mapper.CardMapper">
    <resultMap id="BaseResultMap" type="com.clinic.discount.entity.Card">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="relevance_id" property="relevanceId" jdbcType="INTEGER"/>
        <result column="clinic_id" property="clinicId" jdbcType="INTEGER"/>
        <result column="card_number" property="cardNumber" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="card_type" property="cardType" jdbcType="INTEGER"/>
        <result column="sms_type" property="smsType" jdbcType="BIT"/>
        <result column="selling_type" property="sellingType" jdbcType="INTEGER"/>
        <result column="buyer_name" property="buyerName" jdbcType="VARCHAR"/>
        <result column="buyer_phone" property="buyerPhone" jdbcType="VARCHAR"/>
        <result column="operate" property="operate" jdbcType="BIT"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="charge" property="charge" jdbcType="BIT"/>
        <result column="accounting_id" property="accountingId" jdbcType="INTEGER"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="crt_id" property="crtId" jdbcType="INTEGER"/>
        <result column="crt_name" property="crtName" jdbcType="VARCHAR"/>
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP"/>
        <result column="upd_id" property="updId" jdbcType="INTEGER"/>
        <result column="upd_name" property="updName" jdbcType="VARCHAR"/>
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP"/>
        <result column="revision" property="revision" jdbcType="INTEGER"/>
    </resultMap>

    <insert id="batchInsert">
        insert into card (
        clinic_id,
        relevance_id,
        card_number,
        password,
        card_type,
        crt_id,
        crt_name
        )
        values
        <foreach collection="list" index="index" item="item" separator=",">
            (#{item.clinicId},
            #{item.relevanceId},
            #{item.cardNumber},
            #{item.password},
            #{item.cardType},
            #{item.crtId},
            #{item.crtName})
        </foreach>
    </insert>

    <update id="updateSaleStatusById">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update card set sms_type = #{item.smsType},selling_type = #{item.sellingType},buyer_name = #{item.buyerName},
            buyer_phone = #{item.buyerPhone},status = #{item.status},charge = #{item.charge} ,accounting_id = #{item.accountingId}
            where id = #{item.id}
        </foreach>
    </update>
</mapper>