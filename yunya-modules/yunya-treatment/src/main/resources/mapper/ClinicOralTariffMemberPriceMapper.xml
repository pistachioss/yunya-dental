<mapper namespace="com.yunya.modules.treatment.mapper.ClinicOralTariffMemberPriceMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.tariff.ClinicOralTariffMemberPrice" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="oral_tariff_id" property="oralTariffId" jdbcType="INTEGER" />
    <result column="clinic_id" property="clinicId" jdbcType="INTEGER" />
    <result column="member_type_id" property="memberTypeId" jdbcType="INTEGER" />
    <result column="discount_price" property="discountPrice" jdbcType="DECIMAL" />
    <result column="inservice" property="inservice" jdbcType="BIT" />
    <result column="crt_id" property="crtId" jdbcType="INTEGER" />
    <result column="crt_name" property="crtName" jdbcType="VARCHAR" />
