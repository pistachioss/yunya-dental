  <select id="selectBillFirstPayRecordLogByOrderId" resultType="com.yunya.models.treatment.BillPayRecordLog">
    SELECT bprl.*
    FROM bill_pay_record_log bprl
    LEFT JOIN bill_pay_record bpr ON bpr.id = bprl.bill_pay_record_id
    WHERE bpr.inservice = 1 AND bpr.order_record_id = #{orderRecordId}
    ORDER BY bpr.crt_time ASC
    LIMIT 1
  </select>
