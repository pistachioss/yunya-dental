<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.treatment.mapper.BillRefundOrderDetailMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.treatment.BillRefundOrderDetail" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="org_id" property="orgId" jdbcType="INTEGER" />
    <result column="bill_refund_record_id" property="billRefundRecordId" jdbcType="INTEGER" />
    <result column="order_detail_id" property="orderDetailId" jdbcType="INTEGER" />
    <result column="refund_amount" property="refundAmount" jdbcType="DECIMAL" />
    <result column="inservice" property="inservice" jdbcType="BIT" />
    <result column="crt_id" property="crtId" jdbcType="INTEGER" />
    <result column="crt_name" property="crtName" jdbcType="VARCHAR" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="upd_id" property="updId" jdbcType="INTEGER" />
    <result column="upd_name" property="updName" jdbcType="VARCHAR" />
    <result column="upd_time" property="updTime" jdbcType="TIMESTAMP" />
  </resultMap>

    <select id="selectItemRefundableAmountByOrderDetailId" resultType="java.math.BigDecimal">
        SELECT
            IF(IFNULL(brod.refund_amount,0)>=odpr.received_amount, 0, odpr.received_amount-IFNULL(brod.refund_amount,0)) AS refundAmount
        FROM order_detail_pay_record odpr
        LEFT JOIN (
            SELECT order_detail_id, SUM(refund_amount) AS refund_amount
            FROM bill_refund_order_detail
            WHERE inservice = true
            GROUP BY order_detail_id
        ) brod ON brod.order_detail_id = odpr.order_detail_id
        WHERE odpr.inservice = true
        AND odpr.order_detail_id = #{orderDetailId}
    </select>
</mapper>