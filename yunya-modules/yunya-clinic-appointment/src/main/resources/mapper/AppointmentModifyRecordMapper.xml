  <!-- 通过id查询 -->
  <select id="findAppointModifyRecordById" parameterType="integer" resultType="com.yunya.feign.appointment.vo.AppointModifyRecordVo">
    select
      amr.id,
      amr.org_id as orgId,
      amr.appointment_id as appointmentId,
      amr.appoint_date as appointDate,
      amr.dentist_id as dentistId,
      amr.inservice,
      amr.remarks
    from appointment_modify_record amr
