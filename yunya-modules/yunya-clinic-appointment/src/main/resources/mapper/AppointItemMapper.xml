<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunya.modules.appointment.mapper.AppointItemMapper">
  <resultMap id="BaseResultMap" type="com.yunya.models.appointment.AppointItem">
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="appoint_type_id" jdbcType="INTEGER" property="appointTypeId" />
    <result column="name" jdbcType="VARCHAR" property="name" />
    <result column="duration" jdbcType="INTEGER" property="duration" />
    <result column="remarks" jdbcType="VARCHAR" property="remarks" />
    <result column="inservice" jdbcType="BIT" property="inservice" />
    <result column="crt_id" jdbcType="INTEGER" property="crtId" />
    <result column="crt_name" jdbcType="VARCHAR" property="crtName" />
    <result column="crt_time" jdbcType="TIMESTAMP" property="crtTime" />
    <result column="upt_id" jdbcType="INTEGER" property="uptId" />
    <result column="upd_name" jdbcType="VARCHAR" property="updName" />
    <result column="upd_time" jdbcType="TIMESTAMP" property="updTime" />
  </resultMap>

    <resultMap id="AllOrdersMap" type="com.yunya.modules.appointment.vo.AppointmentItemEnableModelVo">
        <result column="orgId" jdbcType="INTEGER" property="orgId" />
        <result column="typeName" jdbcType="VARCHAR" property="typeName" />
        <collection ofType="com.yunya.modules.appointment.vo.AppointmentItemVo" property="appointmentItemTypes">
            <id column="id" jdbcType="INTEGER" property="id" />
            <result column="itemId" jdbcType="INTEGER" property="appointItemId" />
            <result column="itemName" jdbcType="VARCHAR" property="itemName" />
            <result column="duration" jdbcType="INTEGER" property="duration" />
            <result column="remarks" jdbcType="VARCHAR" property="remarks" />
            <result column="inservice" jdbcType="BIT" property="inservice" />
        </collection>
    </resultMap>



    <!--根基预约名称查询预约项目列表-->
    <select id="selectAppitemByName" parameterType="java.util.Map" resultType="com.yunya.modules.appointment.vo.AppointmentItemVo">
        select
        apt.item_no as id, apt.comp_appitem_id as orderId, apt.item_name as name, apt.app_duration as duration,
        apt.isvalid as isvalid
        from
        app_item apt
        where
        apt.comp_clin_id = #{compClinId}
        <if test="keyword != null and keyword != ''">
            and (item_name like concat('%',#{keyword},'%') or item_no like concat('%',#{keyword},'%')
        </if>
    </select>

    <!-- 查询预约项目 -->
    <select id="selectAllAppointItemByOrgId" resultMap="AllOrdersMap">
        select
        citem.org_id as orgId,
        item.id as itemId,
        item.name as itemName,
        atype.name as typeName,
        item.duration,
        item.remarks,
        item.inservice
        from appoint_item item LEFT JOIN
        clinic_appoint_item  citem
        ON item.id = citem.appoint_item_id
        LEFT JOIN appoint_type atype ON	atype.id = item.appoint_type_id
        where citem.org_id = #{form.orgId}
        <if test="form.appointItemId != null">
            and citem.id = #{form.appointId}
        </if>
        <if test="form.name != null">
            and citem.name = #{form.name}
        </if>
    </select>

    <!--查询预约分类列表-->
    <select id="getByOrderTypeId" resultType="com.yunya.modules.appointment.vo.AppointmentItemVo">
        select
        item.id,
        cai.appoint_item_id as appointItemId,
        item.name as itemName,
        atype.name as typeName,
        item.duration,
        item.inservice,
        item.remarks
        from appoint_item item
        LEFT JOIN clinic_appoint_item cai ON cai.appoint_item_id = item.id
        LEFT JOIN appoint_type atype on  atype.id = item.appoint_type_id
        <where>
            <if test="form.appointItemId != null">
                cai.appoint_item_id=#{form.appointItemId}
            </if>
            <if test="form.itemName != null">
                and item.name like CONCAT(CONCAT('%', #{form.itemName}), '%')
            </if>
        </where>
    </select>

</mapper>