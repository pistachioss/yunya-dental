<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunya.modules.employee.expand.mapper.ClinicEmployeeConfigMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.expand.ClinicEmployeeConfig">
        <id column="id" jdbcType="INTEGER" property="id" />
        <result column="employee_id" jdbcType="INTEGER" property="employeeId" />
        <result column="clinic_id" jdbcType="INTEGER" property="clinicId" />
        <result column="assistant_employee_id" jdbcType="INTEGER" property="assistantEmployeeId" />
        <result column="clinic_department_room_id" jdbcType="INTEGER" property="clinicDepartmentRoomId" />
        <result column="enable_appoint" jdbcType="TINYINT" property="enableAppoint" />
        <result column="enable_registry" jdbcType="TINYINT" property="enableRegistry" />
        <result column="enable_download" jdbcType="TINYINT" property="enableDownload" />
        <result column="inservice" jdbcType="TINYINT" property="inservice" />
        <result column="crt_id" jdbcType="INTEGER" property="crtId" />
        <result column="crt_time" jdbcType="TIMESTAMP" property="crtTime" />
        <result column="upd_id" jdbcType="INTEGER" property="updId" />
        <result column="upd_time" jdbcType="TIMESTAMP" property="updTime" />
    </resultMap>

    <sql id="baseColumn">
        id,employee_id,clinic_id,assistant_employee_id,clinic_department_room_id,enable_appoint,enable_registry,enable_download,
        inservice,crt_id,crt_time,upd_id,upd_time
    </sql>

    <insert id="insertBatch">
        insert into
        `clinic_employee_config`
        (`employee_id`, `clinic_id`)
        values
        <foreach collection ="list" item="item" index= "index" separator =",">
            (#{item.employeeId}, #{item.clinicId})
        </foreach >
    </insert>

    <!-- 批量更新数据 -->
    <update id="updateBatch" parameterType="java.util.List">
        update `clinic_employee_config`
        <trim prefix="set" suffixOverrides=",">
            <trim prefix="assistant_employee_id = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when employee_id=#{item.employeeId}
                     <choose>
                         <when test="item.clinicId != null">
                             and clinic_id=#{item.clinicId}
                         </when>
                     </choose>
                     then #{item.assistantEmployeeId}
                </foreach>
            </trim>
            <trim prefix="clinic_department_room_id = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when employee_id=#{item.employeeId}
                    <choose>
                        <when test="item.clinicId != null">
                            and clinic_id=#{item.clinicId}
                        </when>
                    </choose>
                    then #{item.clinicDepartmentRoomId}
                </foreach>
            </trim>
            <trim prefix="enable_appoint = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    <if test="item.enableAppoint != null">
                        when employee_id=#{item.employeeId}
                        <choose>
                            <when test="item.clinicId != null">
                                and clinic_id=#{item.clinicId}
                            </when>
                        </choose>
                        then #{item.enableAppoint}
                    </if>
                    <if test="item.enableAppoint == null">
                        when employee_id=#{item.employeeId}
                        <choose>
                            <when test="item.clinicId != null">
                                and clinic_id=#{item.clinicId}
                            </when>
                        </choose>
                        then 1
                    </if>
                </foreach>
            </trim>
            <trim prefix="enable_registry = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    <if test="item.enableRegistry != null">
                        when employee_id=#{item.employeeId}
                        <choose>
                            <when test="item.clinicId != null">
                                and clinic_id=#{item.clinicId}
                            </when>
                        </choose>
                        then #{item.enableRegistry}
                    </if>
                    <if test="item.enableRegistry == null">
                        when employee_id=#{item.employeeId}
                        <choose>
                            <when test="item.clinicId != null">
                                and clinic_id=#{item.clinicId}
                            </when>
                        </choose>
                        then 1
                    </if>
                </foreach>
            </trim>
            <trim prefix="enable_download = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    <if test="item.enableDownload != null">
                        when employee_id=#{item.employeeId}
                        <choose>
                            <when test="item.clinicId != null">
                                and clinic_id=#{item.clinicId}
                            </when>
                        </choose>
                        then #{item.enableDownload}
                    </if>
                    <if test="item.enableDownload == null">
                        when employee_id=#{item.employeeId}
                        <choose>
                            <when test="item.clinicId != null">
                                and clinic_id=#{item.clinicId}
                            </when>
                        </choose>
                        then 1
                    </if>
                </foreach>
            </trim>
            <trim prefix="inservice = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    <if test="item.inservice != null">
                        when employee_id=#{item.employeeId}
                        <choose>
                            <when test="item.clinicId != null">
                                and clinic_id=#{item.clinicId}
                            </when>
                        </choose>
                        then #{item.inservice}
                    </if>
                    <if test="item.inservice == null">
                        when employee_id=#{item.employeeId}
                        <choose>
                            <when test="item.clinicId != null">
                                and clinic_id=#{item.clinicId}
                            </when>
                        </choose>
                        then 1
                    </if>
                </foreach>
            </trim>
            <trim prefix="crt_id = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when employee_id=#{item.employeeId}
                    <choose>
                        <when test="item.clinicId != null">
                            and clinic_id=#{item.clinicId}
                        </when>
                    </choose>
                    then #{item.crtId}
                </foreach>
            </trim>
            <trim prefix="crt_time = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when employee_id=#{item.employeeId}
                    <choose>
                        <when test="item.clinicId != null">
                            and clinic_id=#{item.clinicId}
                        </when>
                    </choose>
                    then #{item.crtTime}
                </foreach>
            </trim>
            <trim prefix="upd_id = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when employee_id=#{item.employeeId}
                    <choose>
                        <when test="item.clinicId != null">
                            and clinic_id=#{item.clinicId}
                        </when>
                    </choose>
                    then #{item.updId}
                </foreach>
            </trim>
            <trim prefix="upd_time = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when employee_id=#{item.employeeId}
                    <choose>
                        <when test="item.clinicId != null">
                            and clinic_id=#{item.clinicId}
                        </when>
                    </choose>
                    then #{item.updTime}
                </foreach>
            </trim>
        </trim>
        where employee_id in
        <foreach collection="list" index="index" item="item" open="(" separator="," close=")">
            #{item.employeeId}
        </foreach>
    </update>

    <!-- 根据员工ID和门诊ID删除配置信息 -->
    <delete id="deleteEmployeeConfig">
        delete cec.* from clinic_employee_config cec where cec.employee_id = #{employeeId} and cec.clinic_id = #{clinicId}
    </delete>

    <!-- 批量查询 -->
    <select id="findBatch" resultMap="BaseResultMap">
        select
          <include refid="baseColumn"></include>
        from clinic_employee_config
        <where>
            <if test="orgId != null">
                and clinic_id = #{orgId}
            </if>
            <if test="userIds != null and userIds.size() > 0">
                and employee_id in
                <foreach collection="userIds" item="userId" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </if>
        </where>
    </select>
</mapper>