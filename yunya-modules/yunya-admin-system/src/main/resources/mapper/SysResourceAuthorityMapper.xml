<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.system.mapper.SysResourceAuthorityMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.system.SysResourceAuthority">
        <!--
          WARNING - @mbg.generated
        -->
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="post_id" property="postId" jdbcType="INTEGER"/>
        <result column="post_group_id" property="postGroupId" jdbcType="INTEGER"/>
        <result column="resource_id" property="resourceId" jdbcType="VARCHAR"/>
        <result column="resource_type" property="resourceType" jdbcType="TINYINT"/>
        <result column="parent_id" property="parentId" jdbcType="INTEGER"/>
        <result column="path" property="path" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="inservice" property="inservice" jdbcType="BIT"/>
        <result column="crt_id" property="crtId" jdbcType="INTEGER"/>
        <result column="crt_name" property="crtName" jdbcType="VARCHAR"/>
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP"/>
        <result column="upd_id" property="updId" jdbcType="INTEGER"/>
        <result column="upd_name" property="updName" jdbcType="VARCHAR"/>
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP"/>
    </resultMap>
    <!-- 根据岗位ID查询资源权限列表 -->
    <select id="selectResourceAuthorityList" resultType="com.yunya.modules.system.vo.SysResourceAuthorityVO">
        select
            sra.id,
            sra.post_id as postId,
            p.name as postName,
            sra.post_group_id as postGroupId,
            pg.name as postGroupName,
            sra.resource_id as resourceId,
            sra.resource_type as resourceType
        from sys_resource_authority sra
        left join post p on sra.post_id = p.id
        left join post_group pg on sra.post_group_id = pg.id
        <where>
            <if test="resourceAuthorityForm.postId != null">
                and sra.post_id = #{resourceAuthorityForm.postId}
            </if>
            <if test="resourceAuthorityForm.resourceType != null">
                and sra.resource_type = #{resourceAuthorityForm.resourceType}
            </if>
            <if test="resourceAuthorityForm.postGroupId != null">
                and sra.post_group_id = #{resourceAuthorityForm.postGroupId}
            </if>
        </where>
    </select>
</mapper>