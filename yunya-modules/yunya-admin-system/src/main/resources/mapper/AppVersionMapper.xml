<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.system.mapper.AppVersionMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.system.AppVersion" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="os_name" property="osName" jdbcType="VARCHAR" />
    <result column="release_version" property="releaseVersion" jdbcType="VARCHAR" />
    <result column="alpha_version" property="alphaVersion" jdbcType="VARCHAR" />
    <result column="beta_version" property="betaVersion" jdbcType="VARCHAR" />
    <result column="force_update" property="forceUpdate" jdbcType="BIT" />
    <result column="download_url" property="downloadUrl" jdbcType="VARCHAR" />
    <result column="update_content" property="updateContent" jdbcType="VARCHAR" />
    <result column="crt_name" property="crtName" jdbcType="VARCHAR" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="update_name" property="updateName" jdbcType="VARCHAR" />
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
  </resultMap>

  <resultMap id="BaseAppVersionMap" type="com.yunya.feign.system.vo.AppVersionVO">
    <result column="os_name" property="osName" jdbcType="VARCHAR" />
    <result column="release_version" property="releaseVersion" jdbcType="VARCHAR" />
    <result column="alpha_version" property="alphaVersion" jdbcType="VARCHAR" />
    <result column="beta_version" property="betaVersion" jdbcType="VARCHAR" />
    <result column="force_update" property="forceUpdate" jdbcType="BIT" />
    <result column="download_url" property="downloadUrl" jdbcType="VARCHAR" />
    <result column="update_content" property="updateContent" jdbcType="VARCHAR" />
    <result column="crt_name" property="crtName" jdbcType="VARCHAR" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="update_name" property="updateName" jdbcType="VARCHAR" />
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
  </resultMap>

  <sql id="baseColumns">
    id,os_name,release_version,alpha_version,beta_version,force_update,download_url,update_content,crt_name,crt_time,
    update_name,update_time
  </sql>

  <!-- 添加APP版本信息 -->
  <insert id="addAppVersion" parameterType="com.yunya.feign.system.form.AppVersionAddForm">
    insert into app_version (os_name,release_version,alpha_version,beta_version,force_update,download_url,update_content,crt_name,crt_time,
                             update_name)
           values (#{form.osName},#{form.releaseVersion},#{form.alphaVersion},#{form.betaVersion},#{form.forceUpdate},#{form.downloadUrl},
                   #{form.updateContent},#{form.crtName},#{form.crtTime},#{form.updateName})
  </insert>
  <!-- 获取最新发布的APP版本信息 -->
  <select id="lastReleaseApp" resultMap="BaseAppVersionMap">
    select <include refid="baseColumns"></include>
    from app_version
    <where>
      <if test="form.osName != null and form.osName != ''">
        and os_name = #{form.osName}
      </if>
    </where>
    order by id desc limit 1
  </select>
</mapper>