<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.discount.mapper.CouponOrderVirtualMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.discount.CouponOrderVirtual">
        <!--
          WARNING - @mbg.generated
        -->
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="order_id" property="orderId" jdbcType="INTEGER"/>
        <result column="order_sn" property="orderSn" jdbcType="VARCHAR"/>
        <result column="card_id" property="cardId" jdbcType="INTEGER"/>
        <result column="coupon_id" property="couponId" jdbcType="INTEGER"/>
        <result column="patient_id" property="patientId" jdbcType="INTEGER"/>
        <result column="card_number" property="cardNumber" jdbcType="VARCHAR"/>
        <result column="sold_date" property="soldDate" jdbcType="TIMESTAMP"/>
        <result column="inservice" property="inservice" jdbcType="BIT"/>
        <result column="crt_id" property="crtId" jdbcType="INTEGER"/>
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP"/>
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP"/>
        <result column="upd_id" property="updId" jdbcType="INTEGER"/>
    </resultMap>
    <insert id="insertList" parameterType="List">
        insert into
        `coupon_order_virtual`
        (`order_id`, `order_sn`, `card_id`, `coupon_id`, `patient_id`, `coupon_name`,`package_unit_price`, `card_number`, `sold_date`,
        `crt_id`, `crt_time`, `upd_id`)
        values
        <foreach collection="virtuals" item="item" separator=",">
            (#{item.orderId}, #{item.orderSn}, #{item.cardId}, #{item.couponId},#{item.patientId}
            ,#{item.couponName},#{item.packageUnitPrice},#{item.cardNumber},#{item.soldDate},#{item.crtId},#{item.crtTime},#{item.updId})
        </foreach>
    </insert>

    <select id="refundList" resultType="com.yunya.feign.discount.domain.vo.DeductionRefundRecordVO">
        select cov.coupon_name,
               cov.package_unit_price,
               crd.refund_amount,
               crd.org_id,
               crd.crt_id
        from coupon_refund_detail crd
                 inner join coupon_order_virtual cov on cov.id = crd.order_virtual_id
        where inservice = 0
    </select>

    <select id="usedList" resultType="com.yunya.feign.discount.domain.vo.DeductionUsedRecordVO">
        select cov.coupon_name,
               c.card_number,
               c.sale_channel_id,
               cov.package_unit_price,
               cb.item_id,
               cb.patient_id,
               b.bill_number,
               cb.crt_time,
               cb.org_id,
               cb.crt_id
        from card_benefit cb
                 inner join card c on cb.card_id = c.id
                 inner join coupon_order_virtual cov on c.id = cov.card_id
                 inner join coupon_bill b on cov.order_id = b.order_record_id
        where cb.coupon_type = 5
          and cb.patient_id = 1
    </select>

    <select id="changeList" resultType="com.yunya.feign.discount.domain.vo.DeductionChangeRecordVO">
        select cov.coupon_name,
               cov.package_unit_price,
               c.buyer_id,
               c.sold_target,
               cc.changeTime,
               cc.operateId
        from card c
                 inner join coupon_order_virtual cov on c.id = cov.card_id
                 inner join (select card_id, crt_time as changeTime, crt_id as operateId
                             from card_change
                             order by id
                                 limit 1) cc on c.id = cc.card_id
    </select>
</mapper>