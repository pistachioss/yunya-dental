<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.discount.mapper.DiscountCouponDetailMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.discount.DiscountCouponDetail">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="discount_coupon_id" property="discountCouponId" jdbcType="INTEGER"/>
        <result column="type" property="type" jdbcType="INTEGER"/>
        <result column="detail_id" property="detailId" jdbcType="INTEGER"/>
        <result column="crt_id" property="crtId" jdbcType="INTEGER"/>
        <result column="crt_name" property="crtName" jdbcType="VARCHAR"/>
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP"/>
        <result column="upd_id" property="updId" jdbcType="INTEGER"/>
        <result column="upd_name" property="updName" jdbcType="VARCHAR"/>
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP"/>
        <result column="revision" property="revision" jdbcType="INTEGER"/>
    </resultMap>

    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="id">
        insert into discount_coupon_detail (
        discount_coupon_id,
        `type`,
        detail_id,
        crt_id,
        crt_name
        )
        values
        <foreach collection="list" index="index" item="item" separator=",">
            (#{item.discountCouponId},
            #{item.type},
            #{item.detailId},
            #{item.crtId},
            #{item.crtName})
        </foreach>
    </insert>
</mapper>