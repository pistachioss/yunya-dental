<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunya.modules.discount.mapper.OrderBenefitMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.discount.OrderBenefit">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="order_id" jdbcType="INTEGER" property="orderId"/>
        <result column="total_amount" jdbcType="DECIMAL" property="totalAmount"/>
        <result column="benefit_type" jdbcType="TINYINT" property="benefitType"/>
        <result column="authorized_id" jdbcType="INTEGER" property="authorizedId"/>
        <result column="remark" jdbcType="VARCHAR" property="remark" />
        <result column="is_deleted" jdbcType="BIT" property="deleted"/>
        <result column="crt_id" jdbcType="INTEGER" property="crtId"/>
        <result column="crt_time" jdbcType="TIMESTAMP" property="crtTime"/>
        <result column="upd_id" jdbcType="INTEGER" property="updId"/>
        <result column="upd_time" jdbcType="TIMESTAMP" property="updTime"/>
    </resultMap>

    <select id="selectAccreditDiscountAmountByQuery" resultType="java.math.BigDecimal">
        SELECT
            IFNULL(SUM(total_amount), 0)
        FROM order_benefit
        <where>
            AND is_deleted = 0
            AND benefit_type = 1
            AND authorized_id = #{query.employeeId}
            <if test="query.dateType==0">
                <if test="query.startDate != null and query.startDate != ''">
                    and DATE_FORMAT(crt_time, '%Y-%m-%d' ) &gt;= #{query.startDate}
                </if>
                <if test="query.endDate != null and query.endDate != ''">
                    and DATE_FORMAT(crt_time, '%Y-%m-%d' ) &lt;= #{query.endDate}
                </if>
            </if>
            <if test="query.dateType==1">
                <if test="query.startDate != null and query.startDate != ''">
                    and DATE_FORMAT(crt_time, '%Y-%m' ) &gt;= #{query.startDate}
                </if>
                <if test="query.endDate != null and query.endDate != ''">
                    and DATE_FORMAT(crt_time, '%Y-%m' ) &lt;= #{query.endDate}
                </if>
            </if>
            <if test="query.dateType==2">
                <if test="query.startDate != null and query.startDate != ''">
                    and DATE_FORMAT(crt_time, '%Y' ) &gt;= #{query.startDate}
                </if>
                <if test="query.endDate != null and query.endDate != ''">
                    and DATE_FORMAT(crt_time, '%Y' ) &lt;= #{query.endDate}
                </if>
            </if>
        </where>
    </select>

</mapper>