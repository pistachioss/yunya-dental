<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.discount.mapper.CouponAllocateMapper" >
    <resultMap id="BaseResultMap" type="com.yunya.models.discount.CouponAllocate" >
        <!--
          WARNING - @mbg.generated
        -->
        <id column="id" property="id" jdbcType="INTEGER" />
        <result column="coupon_id" property="couponId" jdbcType="INTEGER" />
        <result column="org_id" property="orgId" jdbcType="INTEGER" />
        <result column="allocate_num" property="allocateNum" jdbcType="INTEGER" />
        <result column="allocate_date" property="allocateDate" jdbcType="TIMESTAMP" />
        <result column="allocate_user_id" property="allocateUserId" jdbcType="INTEGER" />
        <result column="crt_id" property="crtId" jdbcType="INTEGER" />
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
        <result column="upd_id" property="updId" jdbcType="INTEGER" />
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP" />
    </resultMap>

    <select id="countGeneratedByParam" resultType="int">
        select
            count(`allocate_user_id`)
        from `coupon_allocate`
        where `coupon_id` = #{couponId}
        and `crt_time` = #{submitDate}
    </select>

    <insert id="insertAll" parameterType="com.yunya.modules.discount.form.CouponAllocateForm">
        INSERT INTO coupon_allocate (
        id,
        coupon_id,
        org_id,
        allocate_num,
        allocate_date,
        allocate_user_id,
        crt_id,
        crt_time,
        upd_id,
        upd_time
        )
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.id}, #{item.couponId},#{item.orgId}
            ,#{item.allocateNum},#{item.allocateDate},#{item.allocateUserId}
            ,#{item.crtId},#{item.crtTime},
            #{item.updId},#{item.updTime})
        </foreach>
    </insert>

    <select id="findVOList" resultType="com.yunya.modules.discount.vo.CouponAllocateVO">
        SELECT
	sum(allocate_num) allocateNum,
	allocate_date allocateDate,
	allocate_user_id allocateUserId
    FROM
	coupon_allocate
	where coupon_id = #{id}
    GROUP BY
	allocate_date
    </select>
    <select id="findVODetailList" resultType="com.yunya.modules.discount.vo.CouponAllocateDetailVO">
    SELECT
    id,
	org_id orgId,
	allocate_num allocateNum
    FROM
	coupon_allocate
	where allocate_date = #{allocateDate}
    </select>

    <update id="updateAllocateByIds">
        update
            `coupon_allocate`
        set `allocate_user_id` = #{allocateUserId},
            `allocate_date` = #{allocateDate},
            `upd_id` = #{allocateUserId}
        where `id` in
            <foreach collection="couponAllocateIds" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
            and `crt_time` = #{submitDate}
    </update>

    <select id="getOrgAllocateByParam" resultType="com.yunya.feign.discount.domain.bo.OrgCouponAllocateBo">
        select
            `id`                  as `id`,
            sum(`allocate_num`)   as `sumCount`
        from `coupon_allocate`
        where `coupon_id` = #{couponId}
          and `org_id` = #{orgId}
          and isnull(`allocate_user_id`) = 0
        group by `coupon_id`, `org_id`
    </select>

</mapper>