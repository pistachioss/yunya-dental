<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.clinic_base.mapper.CashBalanceMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.clinic_base.CashBalance">
        <!--
          WARNING - @mbg.generated
        -->
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="org_id" property="orgId" jdbcType="INTEGER"/>
        <result column="settlement_date" property="settlementDate" jdbcType="DATE"/>
        <result column="beginning_balance_cash" property="beginningBalanceCash" jdbcType="DECIMAL"/>
        <result column="period_collection" property="periodCollection" jdbcType="DECIMAL"/>
        <result column="deposited_cash" property="depositedCash" jdbcType="DECIMAL"/>
        <result column="ending_balance_cash" property="endingBalanceCash" jdbcType="DECIMAL"/>
        <result column="balance_adjustment" property="balanceAdjustment" jdbcType="DECIMAL"/>
        <result column="adjust_remark" property="adjustRemark" jdbcType="VARCHAR"/>
        <result column="uri" property="uri" jdbcType="VARCHAR"/>
        <result column="inservice" property="inservice" jdbcType="BIT"/>
        <result column="crt_id" property="crtId" jdbcType="INTEGER"/>
        <result column="crt_name" property="crtName" jdbcType="VARCHAR"/>
        <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP"/>
        <result column="upd_id" property="updId" jdbcType="INTEGER"/>
        <result column="upd_name" property="updName" jdbcType="VARCHAR"/>
        <result column="upd_time" property="updTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 查询最近的一条现金结存记录 -->
    <select id="selectRecentCashBalance" resultType="com.yunya.models.clinic_base.CashBalance">
        SELECT
            id,
            settlement_date,
            beginning_balance_cash,
            period_collection,
            deposited_cash,
            ending_balance_cash
        FROM
            cash_balance
        WHERE
            inservice = 1
            AND org_id = #{orgId}
        ORDER BY
            id DESC
            LIMIT 1
    </select>

    <!-- 根据条件查询现金结存列表 -->
    <select id="selectCashBalanceList" resultType="com.yunya.feign.clinic_base.domain.vo.CashBalanceVO">
        SELECT
            id,
            settlement_date AS settlementDate,
            beginning_balance_cash AS beginningBalanceCash,
            period_collection AS periodCollectionCash,
            deposited_cash AS depositedCash,
            balance_adjustment AS balanceAdjustmentCash,
            ending_balance_cash AS endingBalanceCash,
            crt_id AS balancerId,
            crt_name AS balancerName
        FROM
            cash_balance
        <where>
            <if test="query.orgId != null">
                and org_id = #{query.orgId}
            </if>
            <if test="query.startDate != null and query.startDate != ''">
                and settlement_date &gt;= #{query.startDate}
            </if>
            <if test="query.endDate != null and query.endDate != ''">
                and settlement_date &lt;= #{query.endDate}
            </if>
        </where>
        ORDER BY
            settlement_date DESC
    </select>
</mapper>