<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.emr.mapper.TreatPlanRecordHistoryMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.emr.TreatPlanRecordHistory" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="plan_id" property="planId" jdbcType="INTEGER" />
    <result column="org_id" property="orgId" jdbcType="INTEGER" />
    <result column="dentist_id" property="dentistId" jdbcType="INTEGER" />
    <result column="patient_id" property="patientId" jdbcType="INTEGER" />
    <result column="medical_record_id" property="medicalRecordId" jdbcType="INTEGER" />
    <result column="plan_name" property="planName" jdbcType="VARCHAR" />
    <result column="status" property="status" jdbcType="TINYINT" />
    <result column="is_change" property="isChange" jdbcType="TINYINT" />
    <result column="operation" property="operation" jdbcType="TINYINT" />
    <result column="operation_reason" property="operationReason" jdbcType="VARCHAR" />
    <result column="crt_id" property="crtId" jdbcType="INTEGER" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="summary" property="summary" jdbcType="LONGVARCHAR" />
    <result column="remark" property="remark" jdbcType="LONGVARCHAR" />
  </resultMap>

  <select id="selectTreatPlanHistoryPreOneById" resultType="com.yunya.models.emr.TreatPlanRecord">
    SELECT
      tph.plan_id AS id,
      tph.org_id AS orgId,
      tph.plan_name AS planName,
      tph.medical_record_id AS medicalRecordId,
      tph.dentist_id AS dentistId,
      tph.patient_id AS patientId,
      tph.summary,
      tph.remark,
      tph.status,
      tph.crt_id AS crtId,
      tph.crt_time AS crtTime
    FROM treat_plan_history tph
    INNER JOIN (
      SELECT
        MAX(crt_time) AS crt_time,
        plan_id
      FROM treat_plan_history
      WHERE status &lt; #{status}
      AND plan_id = #{planId}
      LIMIT 0, 1
    ) tph2 ON tph2.plan_id = tph.plan_id AND tph.crt_time=tph2.crt_time

  </select>
</mapper>