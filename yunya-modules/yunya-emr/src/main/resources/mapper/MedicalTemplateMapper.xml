<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunya.modules.emr.mapper.MedicalTemplateMapper">
    <resultMap id="BaseResultMap" type="com.yunya.models.emr.MedicalTemplate">
        <id column="id" jdbcType="INTEGER" property="id" />
        <result column="medical_template_category_id" jdbcType="INTEGER" property="medicalTemplateCategoryId" />
        <result column="name" jdbcType="VARCHAR" property="name" />
        <result column="type" jdbcType="TINYINT" property="type" />
        <result column="re_examination" jdbcType="VARCHAR" property="reExamination" />
        <result column="chief_complaint" jdbcType="VARCHAR" property="chiefComplaint" />
        <result column="present_illness" jdbcType="VARCHAR" property="presentIllness" />
        <result column="past_history" jdbcType="VARCHAR" property="pastHistory" />
        <result column="examination" jdbcType="VARCHAR" property="examination" />
        <result column="diagnosis" jdbcType="VARCHAR" property="diagnosis" />
        <result column="plan" jdbcType="VARCHAR" property="plan" />
        <result column="treatment" jdbcType="VARCHAR" property="treatment" />
        <result column="prescription" jdbcType="VARCHAR" property="prescription" />
        <result column="enable" jdbcType="TINYINT" property="enable" />
        <result column="crt_id" jdbcType="INTEGER" property="crtId" />
        <result column="crt_time" jdbcType="TIMESTAMP" property="crtTime" />
        <result column="upd_id" jdbcType="INTEGER" property="updId" />
        <result column="upd_time" jdbcType="TIMESTAMP" property="updTime" />
    </resultMap>

    <update id="updateSort">
        update medical_template
        <trim prefix="set" suffixOverrides=",">
            <trim prefix="sort=case" suffix="end,">
                <foreach collection="list" item="item" index="i">
                    when id=#{item.id} then #{item.sort}
                </foreach>
            </trim>
        </trim>
        where id in
        <foreach close=")" collection="list" item="item" open="(" separator=",">
            #{item.id}
        </foreach>
    </update>

    <update id="updateGenSort">
        update general_template
        <trim prefix="set" suffixOverrides=",">
            <trim prefix="sort=case" suffix="end,">
                <foreach collection="list" item="item" index="i">
                    when id=#{item.id} then #{item.sort}
                </foreach>
            </trim>
        </trim>
        where id in
        <foreach close=")" collection="list" item="item" open="(" separator=",">
            #{item.id}
        </foreach>
    </update>

    <select id="countByCategoryId" resultType="int">
        select
            count(*)
        from
            `medical_template`
        where
            `medical_template_category_id` = #{categoryId}
    </select>

    <select id="countByName" resultType="int">
        select
            count(*)
        from `medical_template`
        where `name` = #{name}
          and `medical_template_category_id` = #{categoryId}
         <if test="id != null">
            and `id` != #{id}
         </if>
    </select>

    <select id="listByKeyword" resultMap="BaseResultMap">
        select
            `id`,
            `name`,
            `type`,
            `chief_complaint`,
            `present_illness`,
            `past_history`,
            `examination`,
            `diagnosis`,
            `plan`,
            `sort`,
            `treatment`,
            `enable`
        from `medical_template`
        where `medical_template_category_id` = #{categoryId}
            <if test="keyword != null" >
                and `name` like concat('%', #{keyword}, '%')
            </if>
            <if test="enable != null">
                and `enable` = #{enable}
            </if>
            <if test="type != null">
                and `type` = #{type}
            </if>
        order by `enable` desc, `sort` desc
    </select>

    <update id="enableById">
        update
            `medical_template`
        set `enable` = #{enable}
        where `medical_template_category_id` = #{categoryId}
          and `id` = #{templateId}
    </update>

    <update id="updateContent">
        update `medical_template`
        set `name`= #{template.name},
            `type`= #{template.type},
            `re_examination`= #{template.reExamination},
            `chief_complaint`= #{template.chiefComplaint},
            `present_illness`= #{template.presentIllness},
            `past_history`= #{template.pastHistory},
            `examination`= #{template.examination},
            `diagnosis`= #{template.diagnosis},
            `plan`= #{template.plan},
            `treatment`= #{template.treatment},
            `prescription`= #{template.prescription},
            `upd_id`= #{template.updId}
        where `id` = #{template.id}
    </update>
</mapper>