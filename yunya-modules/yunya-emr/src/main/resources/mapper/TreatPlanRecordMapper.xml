<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.emr.mapper.TreatPlanRecordMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.emr.TreatPlanRecord" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="org_id" property="orgId" jdbcType="INTEGER" />
    <result column="dentist_id" property="dentistId" jdbcType="INTEGER" />
    <result column="patient_id" property="patientId" jdbcType="INTEGER" />
    <result column="medical_record_id" property="medicalRecordId" jdbcType="INTEGER" />
    <result column="plan_name" property="planName" jdbcType="VARCHAR" />
    <result column="status" property="status" jdbcType="TINYINT" />
    <result column="crt_id" property="crtId" jdbcType="INTEGER" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="summary" property="summary" jdbcType="LONGVARCHAR" />
    <result column="remark" property="remark" jdbcType="LONGVARCHAR" />
  </resultMap>

  <select id="selectTreatPlanRecordInfoList"
            resultType="com.yunya.models.emr.TreatPlanRecord">
    SELECT
        id,
        plan_name AS planName,
        patient_id AS patientId,
        org_id AS orgId,
        status,
        crt_time AS crtTime,
        dentist_id AS dentistId
    FROM treat_plan_record
    <where>
      <if test="query.planName!=null and query.planName!=''">
        AND plan_name like CONCAT(CONCAT('%',#{query.planName}),'%')
      </if>
      <if test="query.patientId != null">
        AND patient_id = #{query.patientId}
      </if>
      <if test="query.status!=null and query.status.size()>0">
        AND status in
        <foreach collection="query.status" item="item" index="index" open="(" close=")" separator=",">
          #{item}
        </foreach>
      </if>
      <if test="query.dateType == 0">
        <if test="query.startDate != null and query.startDate != ''">
          and DATE_FORMAT(crt_time, '%Y-%m-%d') &gt;= #{query.startDate}
        </if>
        <if test="query.endDate != null and query.endDate != ''">
          and DATE_FORMAT(crt_time, '%Y-%m-%d') &lt;= #{query.endDate}
        </if>
      </if>
      <if test="query.dateType == 1">
        <if test="query.startDate != null and query.startDate != ''">
          and DATE_FORMAT(crt_time, '%Y-%m') &gt;= #{query.startDate}
        </if>
        <if test="query.endDate != null and query.endDate != ''">
          and DATE_FORMAT(crt_time, '%Y-%m') &lt;= #{query.endDate}
        </if>
      </if>
      <if test="query.dateType == 2">
        <if test="query.startDate != null and query.startDate != ''">
          and DATE_FORMAT(crt_time, '%Y') &gt;= #{query.startDate}
        </if>
        <if test="query.endDate != null and query.endDate != ''">
          and DATE_FORMAT(crt_time, '%Y') &lt;= #{query.endDate}
        </if>
      </if>
    </where>
    ORDER BY crt_time DESC
  </select>
</mapper>