<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.emr.mapper.MedicalPictureRecordMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.emr.MedicalPictureRecord" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="patient_id" property="patientId" jdbcType="INTEGER" />
    <result column="name" property="name" jdbcType="VARCHAR" />
    <result column="inservice" property="inservice" jdbcType="BIT" />
    <result column="crt_id" property="crtId" jdbcType="INTEGER" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="upt_id" property="uptId" jdbcType="INTEGER" />
    <result column="upt_time" property="uptTime" jdbcType="TIMESTAMP" />
  </resultMap>

  <select id="findMedicalPictureRecordList" resultType="com.yunya.feign.emr.domain.vo.MedicalPictureRecordVO">
    SELECT
        id,
        name
    FROM medical_picture_record
    <where>
        AND inservice = true
        <if test="query.name!=null and query.name!=''">
          AND name = #{query.name}
        </if>
        <if test="query.patientId != null">
          AND patient_id = #{query.patientId}
        </if>
    </where>
    ORDER BY DATE_FORMAT(name,'%Y-%m-%d') DESC
  </select>
</mapper>