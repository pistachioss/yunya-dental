<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunya.modules.treatment.other.mapper.VisitingRecordMapper">
  <resultMap id="BaseResultMap" type="com.yunya.models.treatment_other.VisitingRecord">
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="org_id" jdbcType="INTEGER" property="orgId" />
    <result column="treatment_id" jdbcType="INTEGER" property="treatmentId" />
    <result column="patient_id" jdbcType="INTEGER" property="patientId" />
    <result column="dentist_id" jdbcType="INTEGER" property="dentistId" />
    <result column="dept_room_id" jdbcType="INTEGER" property="deptRoomId" />
    <result column="treatment_date" jdbcType="DATE" property="treatmentDate" />
    <result column="visiting_date" jdbcType="DATE" property="visitingDate" />
    <result column="visiting_time" jdbcType="VARCHAR" property="visitingTime" />
    <result column="reason" jdbcType="VARCHAR" property="reason" />
    <result column="visiting_content" jdbcType="VARCHAR" property="visitingContent" />
    <result column="inservice" jdbcType="BIT" property="inservice" />
    <result column="remarks" jdbcType="VARCHAR" property="remarks" />
    <result column="status" jdbcType="BIT" property="status" />
    <result column="crt_id" jdbcType="INTEGER" property="crtId" />
    <result column="crt_name" jdbcType="VARCHAR" property="crtName" />
    <result column="crt_time" jdbcType="TIMESTAMP" property="crtTime" />
    <result column="upt_id" jdbcType="INTEGER" property="uptId" />
    <result column="upd_name" jdbcType="VARCHAR" property="updName" />
    <result column="upd_time" jdbcType="TIMESTAMP" property="updTime" />
  </resultMap>

  <sql id="baseColumns">
    vr.id,vr.org_id,vr.treatment_id,vr.patient_id,vr.dentist_id,vr.dept_room_id,vr.treatment_date,vr.visiting_date,vr.visiting_time,vr.reason,
    vr.visiting_content,vr.inservice,vr.remarks,vr.status ,vr.crt_id,vr.crt_name,vr.crt_time,vr.upt_id,vr.upd_name,vr.upd_time
  </sql>

  <sql id="FieldAlias">
    id, org_id as orgId, treatment_id as treatmentId, patient_id as patientId, dentist_id as dentistId, dept_room_id as deptRoomId,
    treatment_date as treatmentDate, visiting_date as visitingDate,visiting_time as visitingTime,reason, visiting_content as visitingContent,
    inservice, remarks, `status`, crt_id as crtId, crt_name as crtName, crt_time as crtTime, upt_id as uptId, upd_name as updName, upd_time as updTime
  </sql>

  <!-- 根据随访id查询随访记录（附带后续随访个数） -->
  <select id="findVisitingRecordById" parameterType="java.lang.Integer" resultType="com.yunya.feign.treatment_other.domain.vo.VisitingRecordVo">
    SELECT
    <include refid="baseColumns"></include>,
        ( SELECT COUNT( id ) FROM visiting_record WHERE patient_id = vr.patient_id ) AS visitingCount
    FROM
        `visiting_record` vr
    WHERE
        vr.id = #{id}
  </select>

  <!-- 根据条件查询随访列表 -->
  <select id="findVisitingRecordByCondition" parameterType="com.yunya.feign.treatment_other.domain.query.VisitingRecordQuery" resultType="com.yunya.feign.treatment_other.domain.vo.VisitingRecordVo">
    SELECT
        <include refid="baseColumns"></include>,
    (select count(id) from visiting_record where patient_id = vr.patient_id and visiting_content is null and visiting_date > DATE_FORMAT(#{query.visitingDate},'%Y-%m-%d' )) as visitingCount
    FROM
        `visiting_record` vr
    <where>
      <if test="query.orgId != null">
        vr.org_id = #{query.orgId}
      </if>
      <if test="query.visitingDate != null and query.searchId == 1">
        and DATE_FORMAT(vr.crt_time,'%Y-%m-%d') = DATE_FORMAT(#{query.visitingDate},'%Y-%m-%d')
      </if>
      <if test="query.visitingDate != null and query.searchId == 2">
        and DATE_FORMAT(vr.visiting_date,'%Y-%m-%d') = DATE_FORMAT(#{query.visitingDate},'%Y-%m-%d')
      </if>
      <if test="query.searchBeginTime != null and query.searchEndTime != null">
        and date_format(vr.visiting_date,'%Y-%m-%d') between date_format(#{query.searchBeginTime},'%Y-%m-%d') and date_format(#{query.searchEndTime},'%Y-%m-%d')
      </if>
      <if test="query.patientId != null">
        and vr.patient_id = #{query.patientId}
      </if>
      <if test="query.dentistId != null">
        and vr.dentist_id = #{query.dentistId}
      </if>
      <if test="query.crtId != null">
        and vr.crt_id = #{query.crtId}
      </if>
      <if test="query.inservice != null">
        and vr.inservice = #{query.inservice}
      </if>

      <if test="query.status != null">
        and vr.status = #{query.status}
      </if>
    </where>
    order by vr.crt_time asc
  </select>

  <!-- 根据患者id、时间查询随访列表 -->
  <select id="findAfterVisitingContentByPatientIdAndDate" parameterType="com.yunya.feign.treatment_other.domain.query.VisitingContentAfterCurrentQuery"
          resultMap="BaseResultMap">
      select
        <include refid="baseColumns"></include>
      from visiting_record vr
      <where>
        <if test="query.patientId != null and query.date != null">
          vr.patient_id = #{query.patientId} and vr.visiting_date &gt; DATE_FORMAT(#{query.date},'%Y-%m-%d')
        </if>
        <if test="query.status != null">
          and vr.status = #{query.status}
        </if>
      </where>
  </select>

  <!-- 根据就诊记录ID删除随访 -->
  <delete id="deleteVisitingRecordByTreatmentId" parameterType="java.lang.Integer">
    delete from visiting_record where treatment_id = #{treatmentId}
  </delete>

  <!-- 批量保存随访记录（就诊服务调用） -->
  <insert id="insertEntitys" parameterType="java.util.List" useGeneratedKeys="true">
    insert into visiting_record (org_id,treatment_id,patient_id,dentist_id,dept_room_id,treatment_date,visiting_date,visiting_time,reason,
    visiting_content,inservice,remarks,status ,crt_id,crt_name,crt_time,upt_id,upd_name,upd_time)
    values
    <foreach collection="visitingRecords" item="item" separator=",">
      (#{item.orgId},#{item.treatmentId},#{item.patientId},#{item.dentistId},#{item.deptRoomId},#{item.treatmentDate},#{item.visitingDate},#{item.visitingTime},
      #{item.reason},#{item.visitingContent},#{item.inservice},#{item.remarks},#{item.status},#{item.crtId},#{item.crtName},#{item.crtTime},
      #{item.uptId},#{item.updName},#{item.updTime})
    </foreach>
  </insert>

  <!-- 根据医生ID,开始时间，结束时间查询 -->
  <select id="findVisitingForMonth" resultType="com.yunya.feign.treatment_other.domain.vo.VisitingForMonthVo">
    SELECT
    DATE_FORMAT(a.crt_time,'%Y-%m-%d') as currentDate,
    COUNT(a.id) as `count`
    FROM(
    SELECT
    vr.id,
    DATE_FORMAT(vr.crt_time,'%Y-%m-%d') as crt_time
    FROM
    `visiting_record` vr
    <where>
      <if test="dentistId != null">
        and vr.dentist_id = #{dentistId}
      </if>
      <if test="startDate != null and endDate != null">
        and date_format(vr.visiting_date,'%Y-%m-%d') BETWEEN date_format(#{startDate},'%Y-%m-%d') AND date_format(#{endDate},'%Y-%m-%d')
      </if>
    </where>
    ) a
    GROUP BY a.crt_time
  </select>

  <!-- 统计后续随访个数 -->
  <select id="countNextVisiting" resultType="integer">
    select count(id) from `visiting_record` where patient_id = #{patientId}
    and status = 0 and inservice = 1
    and date_format(visiting_date,'%Y-%m-%d') &gt; date_format(#{regDate},'%Y-%m-%d')
  </select>

  <!-- 根据患者ID集合查询患者后续随访信息列表 -->
  <select id="countNextVisitingListByIds" resultType="com.yunya.feign.treatment_other.domain.vo.NextVisitingRecordVo">
    select
           count(id) as `count`,
           <include refid="FieldAlias"></include>
    from visiting_record
    where
        patient_id in
        <foreach collection="patientIds" item="patientId" open="(" separator="," close=")">
          #{patientId}
        </foreach>
        and status = 0 and inservice = 1
        and date_format(visiting_date,'%Y-%m-%d') &gt; date_format(#{regDate},'%Y-%m-%d')
    group by
        patient_id
  </select>

</mapper>