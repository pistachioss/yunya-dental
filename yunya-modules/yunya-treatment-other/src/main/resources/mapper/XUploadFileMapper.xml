<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunya.modules.treatment.other.mapper.XUploadFileMapper" >
  <resultMap id="BaseResultMap" type="com.yunya.models.treatment_other.XUploadFile" >
    <!--
      WARNING - @mbg.generated
    -->
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="file_name" property="fileName" jdbcType="VARCHAR" />
    <result column="file_type" property="fileType" jdbcType="TINYINT" />
    <result column="source_id" property="sourceId" jdbcType="INTEGER" />
    <result column="source_type" property="sourceType" jdbcType="TINYINT" />
    <result column="file_location" property="fileLocation" jdbcType="VARCHAR" />
    <result column="file_path" property="filePath" jdbcType="VARCHAR" />
    <result column="upload_time" property="uploadTime" jdbcType="TIMESTAMP" />
    <result column="inservice" property="inservice" jdbcType="BIT" />
    <result column="crt_id" property="crtId" jdbcType="INTEGER" />
    <result column="crt_time" property="crtTime" jdbcType="TIMESTAMP" />
    <result column="upd_id" property="updId" jdbcType="INTEGER" />
    <result column="upd_time" property="updTime" jdbcType="TIMESTAMP" />
  </resultMap>

  <!-- 批量添加文件 -->
  <insert id="addBatch" parameterType="list" keyProperty="id" useGeneratedKeys="true">
    insert into x_upload_file
    (file_type,file_name,file_location,source_id,source_type,file_path,
    upload_time,crt_id,crt_time,upd_id,upd_time)
    values
    <foreach collection="files" item="obj" separator=",">
      (#{obj.fileType},#{obj.fileName},#{obj.fileLocation},#{obj.sourceId},#{obj.sourceType},
      #{obj.filePath},#{obj.uploadTime},#{obj.crtId},#{obj.crtTime},#{obj.updId},#{obj.updTime})
    </foreach>
  </insert>

  <!--逻辑删除-->
  <update id="updateUnvaildByEntity">
    UPDATE x_upload_file
    SET inservice = false,
        upd_id = #{crtId},
        upd_time = #{crtTime}
    <where>
        AND source_type = #{query.sourceType}
        AND source_id = #{query.sourceId}
        AND inservice = #{query.inservice}
    </where>
  </update>

  <!--根据条件查询治疗计划列表-->
  <select id="selectXUploadFileList" resultType="com.yunya.feign.treatment_other.domain.vo.XUploadFileVO">
    SELECT
      xuf.id AS fieldId,
      xuf.source_id AS sourceId,
      xuf.source_type AS sourceType,
      xuf.file_name AS fileName,
      xuf.file_type AS fileType,
      xuf.file_location AS fileLocation,
      xuf.upload_time AS uploadTime,
      xuf.crt_id AS crtId,
      xuf.crt_time AS crtTime,
      xuf.upd_id AS updId,
      xuf.upd_time AS updTime
    FROM  x_upload_file xuf
    <where>
      AND xuf.inservice = true
      <if test="query.sourceIds!=null and query.sourceIds.size()>0">
        AND xuf.source_id in
        <foreach collection="query.sourceIds" item="item" open="(" separator="," close=")">
          #{item}
        </foreach>
      </if>
      <if test="query.sourceType != null">
        AND xuf.source_type = #{query.sourceType}
      </if>
    </where>
    order by xuf.crt_time desc
  </select>
</mapper>