  <select id="findSmsSignatureFilesBySignId" resultType="com.yunya.models.sms.SmsSignatureFile">
    select
        t.id,
        t.signature_id as signatureId,
        t.file_type as fileType,
        t.file_url as fileUrl
    from sms_signature_file t
    where t.signature_id = #{signId}
  </select>

  <insert id="insertAll" parameterType="java.util.List">
    INSERT INTO `sms_signature_file`
    (`id`, `signature_id`, `file_type`,`file_url`, `crt_id`, `crt_time`, `upd_id`, `upd_time`)
    VALUES
    <foreach collection="list" item="item" index="index" separator=",">
        (#{item.id}, #{item.signatureId}, #{item.fileType},#{item.fileUrl}, #{item.crtId}, #{item.crtTime}, #{item.updId},#{item.updTime})
    </foreach>
  </insert>
</mapper>